{
  "name": "meme-journal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=.env.local db/migrate.ts",
    "check:env": "tsx --env-file-if-exists=.env.local scripts/check-env.ts",
    "pipeline": "tsx --env-file-if-exists=.env.local pipeline/run.ts",
    "claude:export": "tsx --env-file-if-exists=.env.local pipeline/claude/export.ts",
    "claude:ingest": "tsx --env-file-if-exists=.env.local pipeline/claude/ingest.ts",
    "stats": "tsx --env-file-if-exists=.env.local pipeline/stats.ts",
    "publish": "tsx --env-file-if-exists=.env.local pipeline/publish.ts",
    "reanalyze": "tsx --env-file-if-exists=.env.local pipeline/reanalyze.ts",
    "funnel": "tsx --env-file-if-exists=.env.local pipeline/funnel.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "next": "^16.3.8",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
